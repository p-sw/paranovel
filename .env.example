# Required for AI generation. The app still starts without a key, but AI calls
# return 503 and memory search falls back to keyword-only retrieval.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional web references for planning and writing. Search is disabled without
# this key; existing AI generation and project memory retrieval still work.
TAVILY_API_KEY=

# Task models.
AI_WRITING_MODEL=google/gemini-3.8-flash
AI_IMPROVEMENT_MODEL=openai/gpt-5.6-luna
AI_CHAT_MODEL=openai/gpt-5.6-luna
AI_IMAGE_TAG_MODEL=openai/gpt-5.6-luna
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
# Required Canon/arc/scene/improvement context is never silently truncated.
AI_MANDATORY_CONTEXT_MAX_CHARS=400000

# Local development defaults. Docker Compose overrides DB_PATH and the internal
# service port while retaining PORT for the host-side published port.
HOST=0.0.0.0
PORT=3000
DB_PATH=./data/paranovel.sqlite
PROMPTS_DIR=./prompts

# Optional image name used by Docker Compose.
PARANOVEL_IMAGE=paranovel:local
